# GitHub Personal Access Token (PAT)
# Needs scopes: repo, read:user, write:discussion
GITHUB_TOKEN=ghp_your_personal_access_token_here

# Optional: Secondary helper account token for Galaxy Brain
# (Required for Galaxy Brain because GitHub strictly prevents self-answers)
HELPER_TOKEN=ghp_optional_secondary_token_here

# Target repository name to use as sandbox (will be auto-created if it doesn't exist)
# Default: github-achievements-sandbox
GITHUB_REPO=github-achievements-sandbox

# Optional co-author identifier for Pair Extraordinaire badge (format: Name <email>)
# Default uses Monalisa Octocat
COAUTHOR_NAME=Monalisa Octocat
COAUTHOR_EMAIL=octocat@users.noreply.github.com
